# Copy to backend/.env and fill in. NEVER commit .env.
# The Gemini key must live on the backend only -- anything shipped inside a
# Chrome extension is public, and a leaked free-tier key gets drained.

GEMINI_API_KEY=

# Provider + model. The -lite models get 15 req/min on the free tier; the full
# flash models get 5. See app/analyzer/README.md.
SCAM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING=low

# Optional: Google Safe Browsing key. Without it, link checking runs on local
# heuristics only -- still most of the value. See app/analyzer/README.md.
SAFE_BROWSING_API_KEY=

# Optional
ANALYZE_TIMEOUT_S=30
DATABASE_URL=sqlite:///./scam_guard.db
ALLOWED_ORIGINS=http://localhost:5173
