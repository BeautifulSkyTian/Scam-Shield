{
  "manifest_version": 3,
  "name": "Scam Shield",
  "version": "0.1.0",
  "description": "Analyze suspicious messages and explain their risk.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Scam Shield",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-ui.js"],
      "run_at": "document_idle"
    }
  ]
}
